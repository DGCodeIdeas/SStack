{
    "name": "sovereign-stack/sstack",
    "description": "SovereignStack — clean production-oriented framework",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "SovereignStack\\Core\\": "src/Core/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SovereignStack\\Core\\Config\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
