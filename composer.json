{
    "name": "sovereign-stack/sstack",
    "description": "SovereignStack — clean production-oriented framework",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "ext-pcre": "*",
        "doctrine/dbal": "^4.2",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "twig/twig": "^3.10"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "SovereignStack\\SStack\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SovereignStack\\SStack\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M",
        "ci": ["@stan", "@test"]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
